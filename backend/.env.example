# Server
APP_NAME="Zone De Rassemblement"
PORT=8000
NODE_ENV=development
DATABASE_URL="POSTGRESQL CONNECTION STRING - Replace it here (Neon.com)"
REDIS_URL="upstash.com"
BACKEND_URL="http://localhost:8000"

# JWT: Generate yours at https://jwtsecrets.com/
JWT_SECRET=

# Cloudinary
CLOUDINARY_SECRET_KEY=
CLOUDINARY_API_KEY=
CLOUDINARY_CLOUD_NAME=

# Google
GOOGLE_CLIENT_ID=

# Redis
REDIS_URL=

# Frontend
FRONTEND_URL="http://localhost:3000"

# Email via Resend (HTTPS API - works on Render free tier)
# Get a sending-only key at https://resend.com/api-keys
# Verify your domain at https://resend.com/domains first
RESEND_API_KEY=
EMAIL_FROM="Maison ZDR <noreply@yourdomain.com>"
